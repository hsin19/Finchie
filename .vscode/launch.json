{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "parser: gRPC server",
            "type": "debugpy",
            "request": "launch",
            "module": "finchie_parser",
            "justMyCode": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/apps/parser",
            "python": "${workspaceFolder}/apps/parser/.venv/bin/python"
        },
        {
            "name": "backend: HTTP server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/apps/backend/cmd/backend",
            "cwd": "${workspaceFolder}/apps/backend",
            "envFile": "${workspaceFolder}/.local/backend.env"
        }
    ]
}
